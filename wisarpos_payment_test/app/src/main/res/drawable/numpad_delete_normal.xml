<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow -->
    <item android:top="5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#8B0000" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Key face with red gradient -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF6B6B"
                android:centerColor="#E53935"
                android:endColor="#B71C1C"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#B71C1C" />
        </shape>
    </item>
</layer-list>
