<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bottom shadow — gives the 3D depth -->
    <item android:top="5dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#999999" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Key face with gradient -->
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FFFFFF"
                android:centerColor="#F0F0F0"
                android:endColor="#D8D8D8"
                android:angle="270" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#BBBBBB" />
        </shape>
    </item>
</layer-list>
